{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
